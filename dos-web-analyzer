#!/usr/bin/env python3
"""dos-analysis-web 命令行入口。"""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent


def run(command: list[str]) -> int:
    print("$ " + " ".join(command))
    completed = subprocess.run(command, cwd=BASE_DIR, check=False)
    return completed.returncode


def python_script(script: str, extra: list[str]) -> int:
    return run([sys.executable, str(BASE_DIR / "scripts" / script), *extra])


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Java Web client-state retention DoS analyzer")
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("phase1", help="运行 Phase 1 手工 source 快速验证")
    phase2 = subparsers.add_parser("phase2", help="运行 Phase 2 source 自动发现")
    phase2.add_argument("args", nargs=argparse.REMAINDER)
    phase3 = subparsers.add_parser("phase3", help="运行 Phase 3 统一五轴候选提取")
    phase3.add_argument("args", nargs=argparse.REMAINDER)

    analyze = subparsers.add_parser("analyze", help="运行 Phase 4 排序与复核队列生成")
    analyze.add_argument("--refresh-phase3", action="store_true", help="先重新运行 Phase 3，再生成 Phase 4 产物")
    analyze.add_argument("--top", type=int, default=None, help="Phase 4 复核队列大小")

    report = subparsers.add_parser("report", help="刷新 Phase 4 报告")
    report.add_argument("--top", type=int, default=None, help="报告中的 top-N 队列大小")

    verify = subparsers.add_parser("verify", help="生成 top-N 人工复核队列")
    verify.add_argument("--top", type=int, default=50, help="复核候选数量")

    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if args.command == "phase1":
        return run(["bash", str(BASE_DIR / "scripts" / "run_phase1.sh")])
    if args.command == "phase2":
        return python_script("run_phase2.py", args.args)
    if args.command == "phase3":
        return python_script("run_phase3.py", args.args)
    if args.command == "analyze":
        if args.refresh_phase3:
            code = python_script("run_phase3.py", [])
            if code != 0:
                return code
        extra = []
        if args.top is not None:
            extra.extend(["--top", str(args.top)])
        return python_script("run_phase4.py", extra)
    if args.command == "report":
        extra = ["--report-only"]
        if args.top is not None:
            extra.extend(["--top", str(args.top)])
        return python_script("run_phase4.py", extra)
    if args.command == "verify":
        return python_script("run_phase4.py", ["--verify-only", "--top", str(args.top)])
    raise AssertionError(f"unknown command: {args.command}")


if __name__ == "__main__":
    raise SystemExit(main())
